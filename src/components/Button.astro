---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  trackEvent?: string;
  trackLocation?: string;
  /**
   * 是否作为外链在新标签页打开。
   * - 未设置（undefined）：自动判断 —— href 以 http:// 或 https:// 开头时视为外链
   * - `true`：强制新标签页打开
   * - `false`：强制当前页跳转（即使是绝对 URL）
   */
  external?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className,
  trackEvent,
  trackLocation,
  external,
} = Astro.props;

const base = 'inline-flex items-center justify-center font-medium rounded-md transition-colors no-underline whitespace-nowrap';
// 显式声明 hover 文字色，避免被 base.css 中 `a:hover { color: brand-700 }` 全局规则
// 在 primary 变体上覆盖白字，导致 hover 时文字与背景同色不可见。
const variants = {
  primary: 'bg-brand-600 text-white hover:bg-brand-700 hover:text-white',
  secondary: 'bg-white text-brand-700 border border-brand-200 hover:bg-brand-50 hover:text-brand-700',
  ghost: 'text-brand-700 hover:bg-brand-50 hover:text-brand-700',
};
const sizes = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-5 py-2.5 text-base',
  lg: 'px-7 py-3.5 text-lg',
};

const cls = [base, variants[variant], sizes[size], className].filter(Boolean).join(' ');
const trackAttrs = trackEvent
  ? { 'data-track': trackEvent, 'data-track-location': trackLocation ?? '' }
  : {};

// 判断是否作为外链在新标签页打开
function isExternalLink(href: string | undefined, flag: boolean | undefined): boolean {
  if (flag === true) return true;
  if (flag === false) return false;
  return /^https?:\/\//i.test(href ?? '');
}
const isExt = isExternalLink(href, external);
const extAttrs = isExt ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href ? (
  <a href={href} class={cls} {...trackAttrs} {...extAttrs}>
    <slot />
  </a>
) : (
  <button type={type} class={cls} {...trackAttrs}>
    <slot />
  </button>
)}

{/* CTA 点击追踪统一在 Analytics.astro 中处理 */}
